# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/anamnese_facil
REDIS_URL=redis://redis:6379/0

# LLM (escolha um)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Chat com paciente virtual
CHAT_PROVIDER=openai            # openai | anthropic
CHAT_MODEL=gpt-4o-mini          # padrão: gpt-4o-mini (openai) / claude-haiku-5-5 (anthropic)
CHAT_MAX_HISTORY=20             # mensagens anteriores reenviadas ao LLM
CHAT_MAX_OUTPUT_TOKENS=300
CHAT_MAX_MESSAGES_PER_SESSION=60
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_RATE_LIMIT_PER_MIN=20      # mensagens por aluno por minuto
# Preços USD por 1M tokens [entrada, saída]; confirmar nas páginas oficiais. Ex.:
# CHAT_PRICES_JSON={"anthropic:claude-haiku-5-5": [1.0, 5.0]}

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Auth
SECRET_KEY=troque-por-uma-chave-segura
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO
